# Copy to .env and adjust. All settings are optional.
# Root directory for cache, raw (bronze), processed (silver), features (gold), models.
APEXLENS_DATA_DIR=./data
# Seasons ingested by `make ingest` when none are given on the command line.
APEXLENS_DEFAULT_SEASONS=2022,2023,2024,2025
# Network behaviour for source adapters.
APEXLENS_HTTP_TIMEOUT_S=30
APEXLENS_HTTP_MAX_RETRIES=4
APEXLENS_HTTP_MAX_CONCURRENCY=4
APEXLENS_HTTP_MIN_INTERVAL_S=0.05
# Telemetry is heavy: upper bound of laps per driver per session that are downloaded.
APEXLENS_TELEMETRY_LAPS_PER_DRIVER=1
# Local path to an F1DB git checkout (https://github.com/f1db/f1db). If empty the
# adapter downloads individual YAML files from raw.githubusercontent.com.
APEXLENS_F1DB_LOCAL_PATH=
# API
APEXLENS_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Race-week weather forecast for upcoming races (Open-Meteo). Set to false when offline.
APEXLENS_WEATHER_FORECAST_ENABLED=true
